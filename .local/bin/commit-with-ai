#!/usr/bin/env bash
set -eu

repo="/home/brenden/nixos-config"
cd "$repo"

# Load API key from file if not in environment
if [[ -z "${OPENROUTER_API_KEY:-}" ]]; then
    key_file="${XDG_CONFIG_HOME:-$HOME/.config}/openrouter/api_key"
    if [[ -f "$key_file" ]]; then
        OPENROUTER_API_KEY=$(cat "$key_file")
        export OPENROUTER_API_KEY
    fi
fi

# Check if there are staged or unstaged changes
if git diff --quiet && git diff --cached --quiet; then
    echo "No changes to commit."
    exit 0
fi

# Stage all changes if not already staged
if ! git diff --cached --quiet; then
    git add .
fi

# Get the diff
diff=$(git diff --cached)

# Call OpenRouter API to generate commit message
# Uses openrouter/free model via OpenRouter's chat completions API
if [[ -z "${OPENROUTER_API_KEY:-}" ]]; then
    echo "ERROR: OPENROUTER_API_KEY not set. Create ~/.config/openrouter/api_key or export the variable."
    exit 1
fi

# Build the JSON payload properly using jq to escape the diff
json_payload=$(jq -n --arg diff "$diff" '{
  model: "openrouter/free",
  messages: [
    {
      role: "system",
      content: "You are a commit message generator. Given a git diff, output ONLY a single commit message (max 50 chars). No explanation, no reasoning, no extra text. Just the commit message line. Use conventional commits format. If the diff is empty, output: Empty commit."
    },
    {
      role: "user",
      content: ("Generate a commit message for this git diff:\n\n" + $diff)
    }
  ],
  max_tokens: 2000,
  temperature: 0.3
}')

response=$(curl -s -X POST "https://openrouter.ai/api/v1/chat/completions" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer $OPENROUTER_API_KEY" \
  -H "HTTP-Referer: https://opencode.ai" \
  -H "X-Title: NixOS Commit Assistant" \
  -d "$json_payload")

# Extract the commit message from the response
# Try jq first if available, otherwise fallback to grep/sed
if command -v jq >/dev/null 2>&1; then
    commit_msg=$(echo "$response" | jq -r '.choices[0].message.content // .choices[0].message.reasoning // empty' 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    # If the content is reasoning text, try to extract a commit-like message from it
    if [[ -z "$commit_msg" || "$commit_msg" == "null" ]]; then
        commit_msg=$(echo "$response" | jq -r '.choices[0].message.reasoning // empty' 2>/dev/null | tail -n 1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    fi
else
    commit_msg=$(echo "$response" | grep -A 1 '"content"' | tail -n 1 | sed 's/.*"\(.*\)"\?,.*/\1/' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
fi

# Fallback if API fails or returns empty
if [[ -z "$commit_msg" || "$commit_msg" == "null" ]]; then
    commit_msg="$(git diff --cached --stat | head -n 1 | awk -F' -> ' '{print $1}' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//') ($(date +%Y-%m-%d))"
fi

# Make sure the commit message is not too long
if [[ ${#commit_msg} -gt 72 ]]; then
    commit_msg="${commit_msg:0:72}"
fi

# Show the generated commit message
echo ""
echo "Commit message:"
echo "$commit_msg"
echo ""

# Commit the changes
git commit -m "$commit_msg"

echo "✓ Committed with AI-generated message."

# Push the commit
echo ""
echo "Pushing..."
git push

echo "✓ Pushed."