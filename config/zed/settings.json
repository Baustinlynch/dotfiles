// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
    "anthropic_retention": true
  },
  "context_servers": {
    "HC-CDN": {
      "enabled": true,
      "url": "https://zrl-hccdn.k.hackclub.dev/mcp"
    },
    "Vercel": {
      "enabled": true,
      "url": "https://mcp.vercel.com"
    }
  },
  "proxy": "",
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "amp-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "language_models": {
    "opencode": {
      "show_go_models": true,
      "show_zen_models": true
    },
    "openai_compatible": {
      "HackAI": {
        "api_url": "https://ai.hackclub.com/proxy/v1/",
        "available_models": [
          {
            "name": "nex-agi/nex-n2.5-pro:free",
            "max_tokens": 262144,
            "max_output_tokens": 235929,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false
            }
          }
        ]
      }
    },
    "llama.cpp": {
      "api_url": "http://localhost:8080"
    }
  },
  "agent": {
    "sandbox_permissions": {
      "allow_all_hosts": true,
      "network_hosts": [
        "github.com",
        "*.hackclub.com",
        "hack.club"
      ]
    },
    "default_profile": "write",
    "default_model": {
      "provider": "openrouter",
      "model": "mistralai/ministral-3b-2512",
      "enable_thinking": false
    },
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "openrouter/free",
        "enable_thinking": true
      }
    ],
    "model_parameters": [],
    "tool_permissions": {
      "tools": {
        "create_directory": {
          "default": "allow"
        }
      }
    }
  },
  "cli_default_open_behavior": "existing_window",
  "minimap": {
    "show": "always"
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
}
